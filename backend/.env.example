# Copy to .env; local ADC comes from gcloud auth application-default login.
GOOGLE_ACCOUNT=ad.anushajain@gmail.com
GOOGLE_CLOUD_PROJECT=project-075ab0b6-c39b-4175-9b1
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.8-flash
AI_PROVIDER=gemini
CLOUD_RUN_REGION=asia-south1
CLOUD_RUN_SERVICE=dhalam-api
DHALAM_API_URL=
# Optional non-commercial demo reputation lookup; a separate restricted key.
SAFE_BROWSING_API_KEY=
# Required for --deploy --mobile-auth; must match the native Web client ID.
GOOGLE_WEB_CLIENT_ID=
# Only needed when explicitly selecting the Developer API instead of Vertex.
GEMINI_API_KEY=

# Mobile deployments force true; local loopback development may use false.
REQUIRE_GOOGLE_SIGNIN=false
# Empty allows any verified Google account; optional comma-separated email list.
ALLOWED_GOOGLE_EMAILS=

# Optional direct Meta WhatsApp Cloud API demo. Never commit real values.
# Enter the Graph version shown by Meta's API Setup screen (for example v26.0).
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
# Test account ID shown beside the Phone number ID in Meta's Step 1. Try it out.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# One or more approved test numbers in international digits, without +.
WHATSAPP_ALLOWED_SENDERS=
# A random string you choose; enter the same value in Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=
# Meta app Settings > Basic > App secret.
WHATSAPP_APP_SECRET=
# WhatsApp API Setup > access token; temporary tokens expire.
WHATSAPP_ACCESS_TOKEN=
